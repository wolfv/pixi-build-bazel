load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("@rules_rattler//conda:defs.bzl", "conda_package")

package(default_visibility = ["//visibility:public"])

# Named so its implicit `lib<name>.so` doesn't clash with libgreet.so below.
cc_library(
    name = "greet_lib",
    srcs = ["greet.cc"],
    hdrs = ["greet.h"],
    deps = ["@conda//zlib"],
)

cc_shared_library(
    name = "greet_shared",
    shared_lib_name = "libgreet.so",
    user_link_flags = ["-Wl,-soname,libgreet.so"],
    deps = [":greet_lib"],
)

pkg_files(
    name = "lib",
    srcs = [":greet_shared"],
    prefix = "lib",
)

pkg_files(
    name = "headers",
    srcs = ["greet.h"],
    prefix = "include/libgreet",
)

# lib/libgreet.so + include/libgreet/greet.h. Links zlib from the lock, so
# `libzlib >=...` is added from zlib's run_exports.
conda_package(
    name = "libgreet",
    srcs = [
        ":headers",
        ":lib",
    ],
    license = "MIT",
    run_exports = ["libgreet >=0.1.0,<0.2"],
    summary = "A tiny C library that greets people",
    version = "0.1.0",
)
